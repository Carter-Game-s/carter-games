# Comma-separated exact hosts permitted through the proxy. Default is a safe starter list.
PROXY_ALLOWED_HOSTS=example.com,www.example.com,en.wikipedia.org,www.wikipedia.org,www.google.com,www.bing.com,duckduckgo.com,html.duckduckgo.com
# Never use *; assets and redirects must also be on the list. Keep Codespaces port Private.
PROXY_MAX_BYTES=5000000
PROXY_TIMEOUT_MS=10000
PROXY_REQUESTS_PER_MINUTE=120
