# Empty permits public websites; optionally restrict to comma-separated exact hosts.
PROXY_ALLOWED_HOSTS=
# Do not use * in an explicit host list. Keep the Codespaces port private.
PROXY_MAX_BYTES=5000000
PROXY_TIMEOUT_MS=10000
PROXY_REQUESTS_PER_MINUTE=120

# Optional private VPS asset service. These are server-only values.
GAME_ASSET_BASE_URL=
GAME_ASSET_TOKEN=
GAME_ASSET_VPS_HOST=
