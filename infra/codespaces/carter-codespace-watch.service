[Unit]
Description=Start Carter Games Codespace when stopped
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/carter-codespace-watch/config
LoadCredential=github-token:/etc/carter-codespace-watch/github-token
ExecStart=/usr/bin/python3 /opt/carter-codespace-watch/watch.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
