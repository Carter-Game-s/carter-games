[Unit]
Description=Carter Games isolated interactive browser
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/bin/bash /opt/carter-browser/start.sh
ExecStop=/usr/bin/docker stop carter-browser
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
